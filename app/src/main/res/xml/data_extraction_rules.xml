<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="file"
            path="." />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="grade_tracker_app_prefs.xml" />
        <include
            domain="file"
            path="attachments/" />
    </device-transfer>
</data-extraction-rules>
